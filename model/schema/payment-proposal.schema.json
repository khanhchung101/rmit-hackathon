{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UntrustedPaymentProposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invoiceId",
    "amountMinor",
    "currency",
    "payeeId",
    "payeeAccount"
  ],
  "properties": {
    "invoiceId": {
      "type": "string",
      "minLength": 1
    },
    "amountMinor": {
      "type": "integer",
      "minimum": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "payeeId": {
      "type": "string"
    },
    "payeeAccount": {
      "type": "string"
    }
  }
}
